{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://localhost:5555"
      }
    }
  },
  "AllowedHosts": "*",
  // FileSystemSettings.Path is relative to the app's working directory; Docker overrides it with an absolute path via MaIN__FileSystemSettings__Path.
  "MaIN": {
    "FileSystemSettings": {
      "Path": "Data"
    }
  }
}
