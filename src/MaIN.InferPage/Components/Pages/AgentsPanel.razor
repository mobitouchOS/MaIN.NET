@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using MaIN.Domain.Entities.Agents
@using MaIN.InferPage.Services
@inject AgentDefinitionService AgentService
@inject ActiveAgentState ActiveAgent

<link rel="stylesheet" href="agents.css">

<div class="settings-overlay" @onclick="@(() => OnClose.InvokeAsync())">
    <div class="settings-panel agents-panel" @onclick:stopPropagation="true">
        <div class="settings-header">
            <h2>Agents</h2>
            <FluentButton Appearance="Appearance.Lightweight"
                          Style="--neutral-fill-stealth-rest: transparent; --neutral-fill-stealth-hover: rgba(128,128,128,0.15); --neutral-fill-stealth-active: rgba(128,128,128,0.25);"
                          OnClick="@OnClose"
                          IconStart="@(new Icons.Regular.Size24.Dismiss())">
            </FluentButton>
        </div>

        <div class="settings-body">
            <div class="agents-layout">
                <section class="agents-list">
                    <h3>Saved agents</h3>
                    @if (_agents.Count == 0)
                    {
                        <p class="muted">No agents yet. Create one on the right.</p>
                    }
                    else
                    {
                        @foreach (var agent in _agents)
                        {
                            var isActive = agent.Id == ActiveAgent.Current?.Id;
                            <div class="agent-card @(isActive ? "active" : "")">
                                <div class="agent-card-main">
                                    <strong>@agent.Name</strong>
                                    <span class="muted">@agent.Model</span>
                                    <code class="agent-ref">agent:@agent.Id</code>
                                </div>
                                <div class="agent-card-actions">
                                    @if (isActive)
                                    {
                                        <FluentButton Appearance="Appearance.Lightweight"
                                                      Title="Exit agent"
                                                      OnClick="@ExitActiveAgent"
                                                      IconStart="@(new Icons.Regular.Size20.Dismiss())">
                                        </FluentButton>
                                    }
                                    <FluentButton Appearance="Appearance.Lightweight"
                                                  Title="Use this agent"
                                                  OnClick="@(() => OnAgentSelected.InvokeAsync(agent))"
                                                  IconStart="@(new Icons.Regular.Size20.Chat())">
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Lightweight"
                                                  Title="Edit agent"
                                                  OnClick="@(() => StartEdit(agent))"
                                                  IconStart="@(new Icons.Regular.Size20.Edit())">
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Lightweight"
                                                  OnClick="@(() => DeleteAgent(agent.Id))"
                                                  IconStart="@(new Icons.Regular.Size20.Delete())">
                                    </FluentButton>
                                </div>
                            </div>
                        }
                    }
                </section>
                <section class="agents-form">
                    <h3>@(_editingId is null ? "New agent" : "Edit agent")</h3>
                    <label>Name</label>
                    <FluentTextField @bind-Value="_name" Placeholder="e.g., Research Assistant" Style="width: 100%;" />
                    <label>Model</label>
                    <FluentTextField @bind-Value="_modelId" Placeholder="e.g., gpt-4o, gemma3-4b" Style="width: 100%;" />
                    <label>System prompt</label>
                    <FluentTextArea @bind-Value="_systemPrompt" Rows="5" Placeholder="You are a helpful assistant..." Style="width: 100%;" />
                    <label>Built-in tools</label>
                    <div class="tool-list">
                        @foreach (var tool in _toolChoices)
                        {
                            <FluentCheckbox @bind-Value="tool.Selected">
                                <span title="@tool.Description">@tool.DisplayName</span>
                            </FluentCheckbox>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <p class="error">@_error</p>
                    }
                    <div style="display:flex; gap:0.5rem;">
                        <FluentButton Appearance="Appearance.Accent" OnClick="SaveAgent" Disabled="_busy">
                            @(_busy ? "Saving..." : (_editingId is null ? "Create agent" : "Save"))
                        </FluentButton>
                        @if (_editingId is not null)
                        {
                            <FluentButton Appearance="Appearance.Lightweight" OnClick="CancelEdit" Disabled="_busy">
                                Cancel
                            </FluentButton>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Agent> OnAgentSelected { get; set; }

    private List<Agent> _agents = [];
    private string _name = string.Empty;
    private string _modelId = string.Empty;
    private string _systemPrompt = "You are a helpful assistant.";
    private readonly List<ToolChoice> _toolChoices =
        BuiltInToolCatalog.All.Select(t => new ToolChoice(t.Name, t.DisplayName, t.Description)).ToList();
    private string _error = string.Empty;
    private bool _busy;
    private string? _editingId;

    protected override async Task OnInitializedAsync() => await ReloadAgents();

    private async Task ReloadAgents()
    {
        try
        {
            _agents = await AgentService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAgent()
    {
        _error = string.Empty;
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_modelId))
        {
            _error = "Name and model are required.";
            return;
        }
        _busy = true;
        try
        {
            var toolNames = _toolChoices.Where(t => t.Selected).Select(t => t.Name).ToList();
            var request = new CreateAgentRequest(_name.Trim(), _modelId.Trim(), _systemPrompt, toolNames);
            var editingId = _editingId;

            var savedAgent = editingId is null
                ? await AgentService.CreateAsync(request)
                : await AgentService.UpdateAsync(editingId, request);

            if (editingId is not null && editingId == ActiveAgent.Current?.Id)
            {
                ActiveAgent.Set(savedAgent);
            }

            ResetForm();
            await ReloadAgents();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartEdit(Agent agent)
    {
        _editingId = agent.Id;
        _name = agent.Name;
        _modelId = agent.Model;
        _systemPrompt = agent.Config.Instruction ?? string.Empty;

        var selectedNames = new HashSet<string>(
            agent.ToolsConfiguration?.Tools.Select(t => t.Function?.Name).OfType<string>() ?? Enumerable.Empty<string>(),
            StringComparer.OrdinalIgnoreCase);
        foreach (var t in _toolChoices)
        {
            t.Selected = selectedNames.Contains(t.Name);
        }
        _error = string.Empty;
    }

    private void CancelEdit() => ResetForm();

    private void ResetForm()
    {
        _editingId = null;
        _name = string.Empty;
        _modelId = string.Empty;
        _systemPrompt = "You are a helpful assistant.";
        foreach (var t in _toolChoices) t.Selected = false;
    }

    private void ExitActiveAgent()
    {
        ActiveAgent.Clear();
        StateHasChanged();
    }

    private async Task DeleteAgent(string id)
    {
        _error = string.Empty;
        try
        {
            await AgentService.DeleteAsync(id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        await ReloadAgents();
    }

    // FluentCheckbox @bind-Value needs a settable property expression; a dictionary indexer throws at runtime.
    private sealed class ToolChoice(string name, string displayName, string description)
    {
        public string Name { get; } = name;
        public string DisplayName { get; } = displayName;
        public string Description { get; } = description;
        public bool Selected { get; set; }
    }
}
