{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "MaIN": {
        // web_search prefers SearXNG when set, else falls back to DuckDuckGo scraping. Needs scripts/docker-compose.searxng.yml running.
        "SearxngBaseUrl": "http://localhost:8080",
        "FileSystemSettings": {
            "Path": "Data"
        },
        // SECURITY: off by default -- MCP servers run an arbitrary command on this machine, unsandboxed. See Utils.AllowMcpConfiguration.
        "AllowMcpConfiguration": false
    }
}
